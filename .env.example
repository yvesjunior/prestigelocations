# Configuration de la plateforme — copier vers .env et remplir.
# Les variables VITE_* sont bakées dans le bundle AU BUILD : publiques, jamais de secret.
# Référence complète : TASK.md > « Environnements et configuration (.env) ».

# Panneau de réglage du thème sur le site public (tests uniquement)
#   vide = masqué (défaut) ; 1 = affiché. Pour `npm run dev` : VITE_THEME_TWEAKER=1 npm run dev
VITE_THEME_TWEAKER=

# URL publique du site (Phase 1)
#   dev  : laisser vide (les balises hreflang et les URLs absolues du sitemap sont omises)
#   prod : https://<domaine>, ex. https://prestigelocations.ca
VITE_BASE_URL=

# Ports publiés sur la machine HÔTE (Docker) — utile pour faire tourner plusieurs
# sites sur un même serveur (donner un port différent à chacun). Le port INTERNE
# des conteneurs ne change pas (web=3000, db=5432).
#   WEB_PORT : port public de l'app (défaut 3000)
#   DB_PORT  : port Postgres exposé (défaut 5432) — doit correspondre à DATABASE_URL
#              quand l'app tourne hors conteneur (npm run dev).
WEB_PORT=3000
DB_PORT=5432

# Base de données (Phase 4)
#   dev  : valeurs simples ci-dessous ; prod : mot de passe fort généré
POSTGRES_DB=prestige
POSTGRES_USER=prestige
POSTGRES_PASSWORD=prestige
# Hôte `localhost` quand l'app tourne hors conteneur (npm run dev),
# hôte `db` quand elle tourne dans compose (le compose la construit tout seul).
DATABASE_URL=postgres://prestige:prestige@localhost:5432/prestige

# Superadmin initial (créé au premier seed, jamais écrasé ensuite)
#   min. 10 caractères pour le mot de passe
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@prestige.local
ADMIN_PASSWORD=prestige-dev

# ImageKit (Phase 3) — photos téléversées depuis l'admin, servies par le CDN
#   dev et prod : mêmes valeurs (compte imagekit.io ; dashboard > Developer options)
#   L'URL endpoint est publique (bakée au build) ; les clés sont des secrets runtime.
#   Vide = téléversement désactivé, le site utilise les photos bundlées.
VITE_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Dossier racine des médias dans le compte (sous-dossiers categories/ et equipements/)
IMAGEKIT_FOLDER=prestigelocations

# Courriel sortant — notification des demandes de réservation à l'administrateur.
# Envoi via l'API HTTP de SendGrid (aucune dépendance npm ; port 443 sortant).
#   SENDGRID_API_KEY vide = aucune notification (la demande reste enregistrée dans /admin/demandes).
#   Destinataire = courriel des Coordonnées (BD) — pas de variable ici.
#   SENDGRID_FROM : adresse d'expédition, doit être un « Single Sender » vérifié OU sur un
#     domaine authentifié (SPF/DKIM) chez SendGrid, sinon le courriel part en spam / est refusé.
SENDGRID_API_KEY=
SENDGRID_FROM=

# Mode du site — contrôle la couche « avancée » (calendrier de disponibilité,
# gestion demandes→commandes, rapports).
#   basic (défaut si vide/absent) : vitrine + demande simple. Le client choisit
#     des équipements et envoie une demande (enregistrée + envoyée par courriel) ;
#     un employé le rappelle. Pas de calendrier ni de gestion commandes/rapports.
#   advanced : active le calendrier de disponibilité et les pages admin
#     Demandes / Commandes / Rapports.
# Lu au runtime : changer la valeur puis redémarrer le conteneur suffit (aucun rebuild).
SITE_MODE=basic

# Environnement d'exécution — active les aides « dev/test ».
#   dev : ex. la page de connexion admin affiche les identifiants (ADMIN_EMAIL/
#         PASSWORD) avec bouton copier + explication, pour qu'un testeur se connecte
#         (ex. site exposé via un tunnel Cloudflare temporaire).
#   prod (défaut si vide/absent) : aucune aide dev n'est exposée.
# ⚠️ NE JAMAIS mettre ENV=dev en production (exposerait le mot de passe admin).
ENV=prod
